<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ C:\Projects\WoW\Bin\Interface\FrameXML\UI.xsd">
	<Script file="NuguDropButton.lua"/>

	<Frame name="NuguDropStateHeader" parent="UIParent" inherits="SecureStateHeaderTemplate" hidden="false">
		<!-- tiny and offscreen -->
		<Size><AbsDimension x="1" y="1"/></Size>
		<Anchors>
			<Anchor point="BOTTOMLEFT" relativePoint="TOPRIGHT" relativeTo="UIParent">
				<Offset>
					<AbsDimension x="0" y="0"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Attributes>
			<Attribute name="statemap-anchor-click" value="0:1;1:0"/>
			<Attribute name="statemap-anchor-enter" value="0:1"/>
			<Attribute name="statemap-anchor-leave" value=";"/>
			<Attribute name="delaystatemap-anchor-leave" value="1:0"/>
			<Attribute name="delaytimemap-anchor-leave" value="1:1"/>
			<Attribute name="delayhovermap-anchor-leave" value="1:true"/>
		</Attributes>

	</Frame>

	<Button name="NuguDropButton" parent="NuguDropStateHeader" inherits="SecureAnchorEnterTemplate" toplevel="true" hidden="true" frameStrata="MEDIUM" enableMouse="true" movable="true">
		<NormalTexture file="Interface\AddOns\NuguDrop\images\ND"/>
		<PushedTexture file="Interface\AddOns\NuguDrop\images\ND_over"/>
		<HighlightTexture alphaMode="ADD" file="Interface\Minimap\UI-Minimap-ZoomButton-Highlight"/>
		<Size>
			<AbsDimension x="30" y="30"/>
		</Size>
		<Anchors>
			<Anchor point="BOTTOM" relativeTo="Minimap">
				<Offset>
					<AbsDimension x="-65" y="112"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Scripts>
			<OnLoad>
				this:RegisterEvent("VARIABLES_LOADED");
				<!-- this:RegisterForClicks("LeftButtonUp", "RightButtonUp"); -->
				this:RegisterForClicks("AnyUp");
				this:RegisterForDrag("LeftButton", "RightButton")
				this.tooltip = NUGUDROP_BUTTON_TOOLTIP;
			</OnLoad>
			<OnEnter>
				GameTooltip:SetOwner(this, "ANCHOR_LEFT");
				GameTooltip:SetText(this.tooltip);
			</OnEnter>
			<OnLeave>
				GameTooltip:Hide();
			</OnLeave>
			<OnEvent>
				NuguDropButton_OnEvent(event);
			</OnEvent>
			<OnClick>
				NuguDropButton_OnClick(arg1);
			</OnClick>
			<OnMouseUp>
				NuguDropButton_OnDragStop(this);
			</OnMouseUp>
			<OnDragStart>
				NuguDropButton_OnDragStart(this);
			</OnDragStart>
			<OnDragStop>
				NuguDropButton_OnDragStop(this);
			</OnDragStop>
		</Scripts>
		<Attributes>
			<Attribute name="anchorchild" value="$parent"/>
			<Attribute name="childstate-OnEnter" value="enter"/>
			<Attribute name="childstate-OnLeave" value="leave"/>
		</Attributes>
	</Button>
 </Ui>
