<!-- 타이틀바 -->
	<Frame name="NDFavoritesTitleFrame" toplevel="true" frameStrata="DIALOG" enableMouse="true" movable="true" parent="UIParent" hidden="true">
		<Size>
			<AbsDimension x="449" y="29" />
		</Size>
		<Anchors>
			<Anchor point="CENTER">
				<Offset>
					<AbsDimension x="0" y="300" />
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentTitle" inherits="GameFontHighlightLarge" justifyH="LEFT" text="|cff00ffff누구드랍|r 즐겨찾기">
	 				<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="16" y="-8" />
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentClass" inherits="GameFontHighlightLarge" justifyH="LEFT" text="">
	 				<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentTitle" relativePoint="TOPRIGHT">
							<Offset>
								<AbsDimension x="5" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<Texture name="NDFavoritesTitle" file="Interface\AddOns\NuguDrop\images\NuguDropTitle_Background">
					<Size>
						<AbsDimension x="150" y="23" />
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="3" y="-3" />
							</Offset>
						</Anchor>
						<Anchor point="TOPRIGHT">
							<Offset>
								<AbsDimension x="-3" y="-3" />
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Button name="NDFavorites_Close">
				<Size>
					<AbsDimension x="16" y="16" />
				</Size>
				<Anchors>
					<Anchor point="TOPRIGHT">
						<Offset>
							<AbsDimension x="-6" y="-8" />
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>this:GetParent():Hide();</OnClick>
				</Scripts>
				<NormalTexture file="Interface\AddOns\NuguDrop\images\CloseButton-Up" />
				<PushedTexture file="Interface\AddOns\NuguDrop\images\CloseButton-Down" />
				<HighlightTexture file="Interface\AddOns\NuguDrop\images\Status-Idle" alphaMode="ADD" />
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				this:SetClampedToScreen(true);
			</OnLoad>
			<OnMouseDown>this:StartMoving();</OnMouseDown>
			<OnMouseUp>this:StopMovingOrSizing();</OnMouseUp>
		</Scripts>
	</Frame>

<!-- 직업별 버튼 템플릿 -->
	<Frame name="NDFavBorder" movable="true" virtual="true">
		<Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="" tile="true">
			<EdgeSize>
				<AbsValue val="0"/>
			</EdgeSize>
			<TileSize>
				<AbsValue val="16"/>
			</TileSize>
			<BackgroundInsets>
				<AbsInset left="4" right="4" top="4" bottom="4"/>
			</BackgroundInsets>
		</Backdrop>
	</Frame>

	<Button name="NDFav_Button" inherits="NDFavBorder" virtual="true">
		<Layers>
			<Layer>
				<FontString name="$ParentText" inherits="GameFontHighlightLarge" wraponspaces="true" justifyH="CENTER">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
					<Color r="1.0" g="1.0" b="1.0"/>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnEnter>
				this:RegisterForClicks("LeftButtonUp","RightButtonUp","MiddleButtonUp");
				this:GetParent():SetBackdropColor(1, 1, 0, 1);
			</OnEnter>
			<OnLeave>
			</OnLeave>
		</Scripts>
	</Button>

