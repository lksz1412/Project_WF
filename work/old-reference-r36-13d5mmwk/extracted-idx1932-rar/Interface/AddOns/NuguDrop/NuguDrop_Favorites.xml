		<Frames>
			<Button name="NDClass1" inherits="NDFav_Button" text="전사(방어)">
				<Size>
					<AbsDimension x="104" y="25"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="ND_Class10" relativePoint="TOPLEFT">
						<Offset>
							<AbsDimension x="3" y="-3"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						local color = RAID_CLASS_COLORS["WARRIOR"];
						this:SetBackdropColor(color.r, color.g, color.b, 1);
					</OnLoad>
					<OnLeave>
						if NuguDropOption["lastseen"] == 1 then
							this:GetParent():SetBackdropColor(1, 0, 0, 1);
						else
							this:GetParent():SetBackdropColor(0, 0, 0, 1);
						end
					</OnLeave>
					<OnClick>
						local lastframe = "ND_Class"..NuguDropOption.lastseen.."0"
						getglobal(lastframe):SetBackdropColor(0, 0, 0, 1);
						this:GetParent():SetBackdropColor(1, 0, 0, 1);
						NuguDropOption["lastseen"] = 1;
						ND_FavList_Flush();
						ND_FavList_Generator();
					</OnClick>
				</Scripts>
				<NormalFont style="GameFontHighlightLarge"/>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				this:SetBackdropColor(0, 0, 0, 1);
			</OnLoad>
		</Scripts>
