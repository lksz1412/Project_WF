	<Button name="ExaminerButtonFrame1" frameStrata="MIDDLE" toplevel="true" enableMouse="true" movable="true" parent="UIParent" hidden="true">
		<Size>
			<AbsDimension x="32" y="32"/>
		</Size>
		<Anchors>
			<Anchor point="CENTER" relativeTo="UIParent" relativePoint="CENTER">
				<Offset>
					<AbsDimension x="0" y="0"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Scripts>
			<OnLoad>
				ExaminerButton_OnLoad();
			</OnLoad>
			<OnEvent>
				ExaminerButton_OnEvent(event);
			</OnEvent>
			<OnClick>
				if (Examiner:IsVisible()) then
					HideUIPanel(Examiner);
				else
					Examiner_InspectUnit("target");
				end
			</OnClick>
			<OnDragStart>
				ExaminerButton_OnDragStart();
			</OnDragStart>
			<OnDragStop>
				ExaminerButton_OnDragStop();
			</OnDragStop>
			<OnMouseUp>
				ExaminerButton_OnDragStop();
			</OnMouseUp>
		</Scripts>
		<NormalTexture file="Interface\AddOns\ExaminerButton\ExaminerButton1-UpNew"/>
