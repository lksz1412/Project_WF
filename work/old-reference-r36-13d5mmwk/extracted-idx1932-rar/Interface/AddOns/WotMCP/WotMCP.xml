<Ui>

	<Frame name="WotMCPListTemplate" virtual="true">
		<Size x="328" y="20"/>
		<Layers>
			<Layer level="BACKGROUND">
				<FontString name="$parentName" font="GameFontHighlight" justifyH="LEFT" justifyV="MIDDLE" text="AddOn Name Version 1.0 a really long name">
					<Size x="280" y="20"/>
					<Anchors>
						<Anchor point="RIGHT">
							<Offset x="-4" y="0"/>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<CheckButton name="$parentCheckButton">
				<Size x="24" y="24"/>
				<Anchors>
					<Anchor point="RIGHT" relativeTo="$parentName" relativePoint="LEFT">
						<Offset x="0" y="0"/>
					</Anchor>
				</Anchors>
				<HitRectInsets>
					<AbsInset left="0" right="-280" top="0" bottom="0"/>
				</HitRectInsets>
				<Scripts>
					<OnClick>
						WotMCP.CheckButtonOnClick(self)
					</OnClick>
					<OnEnter>
						WotMCP.CheckButtonOnEnter(self)
					</OnEnter>
					<OnLeave>
						GameTooltip:Hide()
					</OnLeave>
				</Scripts>
				<NormalTexture file="Interface\Buttons\UI-CheckBox-Up"/>
				<PushedTexture file="Interface\Buttons\UI-CheckBox-Down"/>
			 	<HighlightTexture file="Interface\Buttons\UI-CheckBox-Highlight" alphaMode="ADD"/>
				<CheckedTexture file="Interface\Buttons\UI-CheckBox-Check"/>
				<DisabledCheckedTexture file="Interface\Buttons\UI-CheckBox-Check-Disabled"/>		
			</CheckButton>
			<Button name="$parentToggle">
				<Size>
					<AbsDimension x="16" y="16"/>
				</Size>
				<Anchors>
					<Anchor point="RIGHT" relativeTo="$parentCheckButton" relativePoint="LEFT">
						<Offset>
							<AbsDimension x="0" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						WotMCP.ToggleOnClick(self)
					</OnClick>
				</Scripts>
				<NormalTexture name="$parentNormalTexture" file="Interface\Buttons\UI-MinusButton-UP"/>
				<PushedTexture name="$parentPushedTexture" file="Interface\Buttons\UI-MinusButton-DOWN"/>
				<HighlightTexture name="$parentHighlightTexture" file="Interface\Buttons\UI-PlusButton-Hilight" alphaMode="ADD"/>
			</Button>
		</Frames>
	</Frame>

	<Frame name="WotMCPFrame" hidden="true">
		<Layers>
			<Layer level="BACKGROUND">
				<FontString name="WotMCPFrameTitle" font="GameFontNormalLarge" justifyH="LEFT" justifyV="TOP" text="Wrath of the MCP">
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset x="16" y="-16"/>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="WotMCPFrameVersion" font="GameFontNormalSmall" justifyH="LEFT" justifyV="BOTTOM">
					<Anchors>
						<Anchor point="BOTTOMLEFT" relativeTo="WotMCPFrameTitle" relativePoint="BOTTOMRIGHT">
							<Offset x="4" y="1"/>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="WotMCPFrameDesc" font="GameFontHighlightSmall" justifyH="LEFT" justifyV="TOP" text="애드온의 사용 여부를 설정합니다. 체크시 사용, 비 체크시 사용을 하지 않으며, 변경된 내용을 적용하기 위해 재시작이나 게임을 다시 로그인 하셔야 합니다.">
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="WotMCPFrameTitle" relativePoint="BOTTOMLEFT">
							<Offset x="0" y="-8"/>
						</Anchor>
						<Anchor point="BOTTOMRIGHT" relativePoint="TOPRIGHT">
							<Offset x="-16" y="-72"/>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="WotMCPFrameReload" inherits="UIPanelButtonTemplate" text="재시작">
				<Size>
					<AbsDimension x="96" y="22"/>
				</Size>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" relativeTo="InterfaceOptionsFrameOkay" relativePoint="BOTTOMLEFT"/>
				</Anchors>
				<Scripts>
					<OnClick>
						WotMCP:Reload()
					</OnClick>
				</Scripts>
			</Button>
			<Frame name="WotMCPScrollFrameBackdrop">
				<Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
					<BackgroundInsets>
						<AbsInset left="4" right="4" top="4" bottom="4" />
					</BackgroundInsets>
					<TileSize>
						<AbsValue val="16" />
					</TileSize>
					<EdgeSize>
						<AbsValue val="16" />
					</EdgeSize>
					<BorderColor r=".5" g=".5" b=".5"/>
				</Backdrop>
				<Frames>
					<ScrollFrame name="WotMCPScrollFrame" inherits="FauxScrollFrameTemplate">
						<Layers>
							<Layer level="BACKGROUND">
								<Texture file="Interface\ChatFrame\ChatFrameBackground">
									<Anchors>
										<Anchor point="TOPLEFT" relativePoint="TOPRIGHT">
											<Offset>
												<AbsDimension x="6" y="0"/>
											</Offset>
										</Anchor>
										<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT">
											<Offset>
												<AbsDimension x="22" y="0"/>
											</Offset>
										</Anchor>
									</Anchors>
									<Gradient>
										<MinColor r=".5" g=".5" b=".5" a="0"/>
										<MaxColor r="0" g="0" b="0" a="1"/>
									</Gradient>
								</Texture>
							</Layer>
						</Layers>
						<Scripts>
							<OnVerticalScroll>
								if GetBuildInfo()=="2.4.3" then -- if on a BC client
									FauxScrollFrame_OnVerticalScroll(20, WotMCP.ScrollFrameUpdate)
								else -- if on a WotLK client
									FauxScrollFrame_OnVerticalScroll(self,offset,20,WotMCP.ScrollFrameUpdate)
								end
							</OnVerticalScroll>
						</Scripts>
					</ScrollFrame>
				</Frames>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad>
				WotMCP.OnLoad(self)
			</OnLoad>
			<OnShow>
				WotMCP.OnShow(self)
			</OnShow>
		</Scripts>
	</Frame>
</Ui>
