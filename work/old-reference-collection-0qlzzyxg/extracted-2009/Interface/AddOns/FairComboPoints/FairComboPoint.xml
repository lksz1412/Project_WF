<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd"> 

<Frame name="Fair_ComboTemplete" enableMouse="true" parent="UIParent" frameStrata="HIGH" moveable = "true" virtual="true">
  <Size><AbsDimension x="50" y="50"/></Size>
  <Anchors><Anchor point="CENTER">
    <Offset><AbsDimension x="0" y="0"/></Offset>
  </Anchor></Anchors>
  		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parent_Texture">
					<Color r="1" g="1" b="1"/>															
				</Texture>
			</Layer>
		</Layers>
  <Scripts>
    <OnUpdate>

    </OnUpdate>
  </Scripts>
</Frame>

	<Frame name="FCP_CP1" inherits="Fair_ComboTemplate"/>
	<Frame name="FCP_CP2" inherits="Fair_ComboTemplate"/>
	<Frame name="FCP_CP3" inherits="Fair_ComboTemplate"/>
	<Frame name="FCP_CP4" inherits="Fair_ComboTemplate"/>
	<Frame name="FCP_CP5" inherits="Fair_ComboTemplate"/>


	<Frame name="FCP_FlashTemplate" parent="UIParent" frameStrata="BACKGROUND" movable="true" virtual="true" hidden="true" >
		<Size><AbsDimension x="130" y="130"/></Size>		
		<Layers>
			<Layer level="ARTWORK">
                  <Texture name="$parentShine" file="Interface\Cooldown\star4" alphaMode="ADD"/>
			</Layer>
		</Layers>
	</Frame>
<Frame name="FCP_FL1" inherits="FCP_FlashTemplate"/>
<Frame name="FCP_FL2" inherits="FCP_FlashTemplate"/>
<Frame name="FCP_FL3" inherits="FCP_FlashTemplate"/>
<Frame name="FCP_FL4" inherits="FCP_FlashTemplate"/>
<Frame name="FCP_FL5" inherits="FCP_FlashTemplate"/>

</Ui>
