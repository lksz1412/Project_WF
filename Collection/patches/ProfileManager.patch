 ef:UnregisterAllEvents()
 ef:RegisterEvent("PLAYER_LOGIN")
 ef:RegisterEvent("ADDON_LOADED")
-ef:SetScript("OnEvent", function(_, event)
+-- ADDON_LOADED arrives once per addon at login: the rescan runs once after the
